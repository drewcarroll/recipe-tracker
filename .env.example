# Supabase configuration
# Find these values in your Supabase project dashboard:
# Project Settings -> API

# Public URL of your Supabase project (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose to the browser, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (NEVER expose to the browser; server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for "Create using AI" recipe parsing
# (NEVER expose to the browser; used only by backend API routes)
ANTHROPIC_API_KEY=your-anthropic-api-key
